pragma solidity ^0.8.20;

interface IERC20 {
    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(
        address from,
        address to,
        uint256 amount
    ) external returns (bool);
}

contract PrivateBridge {
    address public owner;
    address public relayer;

    mapping(bytes32 => bool) public usedNullifiers;

    event PrivateDeposit(
        bytes32 indexed commitment,
        address indexed token,
        uint256 amount,
        uint256 destinationChain
    );

    event PrivateWithdrawal(
        bytes32 indexed nullifier,
        address indexed token,
        uint256 amount
    );

    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    modifier onlyRelayer() {
        require(msg.sender == relayer, "Not authorized");
        _;
    }

    constructor(address _relayer) {
        owner = msg.sender;
        relayer = _relayer;
    }

    // Update authorized relayer
    function setRelayer(address _relayer) external onlyOwner {
        require(_relayer != address(0), "Invalid relayer");
        relayer = _relayer;
    }

    // Lock tokens and generate privacy commitment
    function deposit(
        address token,
        uint256 amount,
        uint256 destinationChain,
        bytes32 commitment
    ) external {
        require(token != address(0), "Invalid token");
        require(amount > 0, "Invalid amount");
        require(commitment != bytes32(0), "Invalid commitment");

        require(
            IERC20(token).transferFrom(
                msg.sender,
                address(this),
                amount
            ),
            "Transfer failed"
        );

        emit PrivateDeposit(
            commitment,
            token,
            amount,
            destinationChain
        );
    }

    // Relayer releases tokens after verifying source-chain deposit
    function withdraw(
        address token,
        address recipient,
        uint256 amount,
        bytes32 nullifier
    ) external onlyRelayer {
        require(recipient != address(0), "Invalid recipient");
        require(amount > 0, "Invalid amount");
        require(!usedNullifiers[nullifier], "Already claimed");

        // Prevent replay attacks
        usedNullifiers[nullifier] = true;

        require(
            IERC20(token).transfer(recipient, amount),
            "Transfer failed"
        );

        emit PrivateWithdrawal(
            nullifier,
            token,
            amount
        );
    }

    // Emergency token recovery
    function emergencyWithdraw(
        address token,
        uint256 amount
    ) external onlyOwner {
        require(
            IERC20(token).transfer(owner, amount),
            "Transfer failed"
        );
    }

    function transferOwnership(address newOwner) external onlyOwner {
        require(newOwner != address(0), "Invalid owner");
        owner = newOwner;
    }
}
